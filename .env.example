# Copy to .env.local and fill in. Never commit .env.local.

# --- Firebase web config (client) ---
# Not secrets: access is enforced by firestore.rules, not by hiding these.
# Project settings → Your apps → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- The Blue Alliance (server) ---
# Read key from https://www.thebluealliance.com/account
# Backs the Event tab sync and the Pit Dashboard's live match feed.
TBA_API_KEY=

# --- FRC Nexus (server) ---
# API key from https://frc.nexus/api
# Backs the pit map on the Event tab and live queueing on the Pit Dashboard.
# Optional: without it those two features show a setup message and the rest of
# the app is unaffected.
NEXUS_API_KEY=

# --- Manual Q&A / Cloudflare AI Search (server) ---
# Optional: backs the Manual Q&A tab (retrieval over the game manual PDF).
# Nothing is baked into the source, so this is inert until you point it at
# your own Cloudflare account — without it the tab reports the manual isn't
# loaded and the rest of the app is unaffected.
#
# Two ways to run it, in this order of preference:
#  1. In-app, straight against the AI Search REST API — set all three of
#     CF_AI_SEARCH_TOKEN, CF_ACCOUNT_ID and CF_AI_SEARCH_INSTANCE.
#  2. Through a Cloudflare Worker proxy — set MANUAL_QA_RAG_URL to its base
#     URL (see the worker in soft-hill-26e4/).
CF_AI_SEARCH_TOKEN=
CF_ACCOUNT_ID=
CF_AI_SEARCH_INSTANCE=
MANUAL_QA_RAG_URL=

# --- Firebase service account (server) ---
# Only needed for permanently deleting a member from the Team tab: removing
# someone else's auth account is privileged, so the web API key above can't do
# it. Without this the app still runs and admins can deactivate members; the
# Delete button reports that it isn't configured.
# Firebase console → Project settings → Service accounts → Generate new private
# key, then paste the JSON here (or base64-encode it, which avoids hosting
# dashboards mangling the newlines inside private_key).
FIREBASE_SERVICE_ACCOUNT_KEY=
